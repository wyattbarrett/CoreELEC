From: Wyatt Barrett <wyatt.barrett@gmail.com>
Subject: [PATCH] Amlogic-no: fix remote repeat delay for S905X4

---
 arch/arm64/boot/dts/amlogic/meson-sc2.dtsi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
index 0000000..1111111 100644
--- a/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-sc2.dtsi
@@ -2007,4 +2007,7 @@
 		wakeup_map = <&ir_wakeup_key>;
 		mboxes = <&mbox_fifo SC2_REE2AO_IR>;
 		max_frame_time = <200>;
+		linux,rc-map-name = "rc-khadas-vims";
+		linux,rc-repeat-delay = <500>;
+		linux,rc-repeat-period = <125>;
 	};
